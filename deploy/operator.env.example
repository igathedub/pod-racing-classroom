# TEMPLATE ONLY. Copy OUTSIDE the Git repository and protect with owner-only ACLs.
# Missing required values intentionally stop Compose; no passwords/tokens are supplied.
# Keep existing production username/hash and teacher/data secrets unchanged on updates.
POD_SITE_USER=igor
POD_SITE_PASSWORD_HASH=
POD_APP_IMAGE=
POD_BOT_IMAGE=
POD_DATA_VOLUME=
POD_DOCKER_SOCKET=/var/run/docker.sock
POD_APP_CPUS=4.0
POD_APP_MEMORY=1536m
# Explicit feature choice per role. Set checkpoint-only for the approved one-line rollout.
# Unset defaults to legacy; empty/unknown values fail app startup.
POD_INPUT_PROTOCOL=legacy
# Backup only: must match Cloudflare Worker secret BACKUP_EDGE_SECRET.
POD_BACKUP_EDGE_SECRET=
